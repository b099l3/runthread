---
import "../styles/global.css";

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? "https://runthread.app";
const loopsFormId = import.meta.env.PUBLIC_LOOPS_FORM_ID ?? "";
const signupAction = loopsFormId
  ? `https://app.loops.so/api/newsletter-form/${loopsFormId}`
  : "";

const features = [
  {
    label: "Plan",
    title: "A week that starts realistic.",
    body: "Runthread builds around your current training, available days, and the work that matters most.",
  },
  {
    label: "Sync",
    title: "Completed runs come back in.",
    body: "Strava-backed imports let the app react to what actually happened, not what you remembered to mark done.",
  },
  {
    label: "Match",
    title: "Activities meet the right workout.",
    body: "Date, distance, duration, and type are used to connect a completed run to the plan with clear confidence.",
  },
  {
    label: "Adapt",
    title: "Changes stay calm.",
    body: "When a week shifts, Runthread explains what changed and why, without pretending every run needs a dramatic reset.",
  },
];

const previewCards = [
  {
    label: "Today",
    title: "Easy run",
    detail: "7.2 km / relaxed",
    note: "Scheduled for recovery after Tuesday's workout.",
    status: "Ready",
  },
  {
    label: "Imported",
    title: "Morning run",
    detail: "6.8 km / 42 min",
    note: "Matched to today's easy run with high confidence.",
    status: "Matched",
  },
  {
    label: "Updated",
    title: "Long run adjusted",
    detail: "15.0 km to 13.5 km",
    note: "Reduced slightly after a partial completion earlier in the week.",
    status: "Adapted",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Runthread | Adaptive Running Training</title>
    <meta
      name="description"
      content="Runthread is an adaptive running training app that connects planned workouts to real activity data and keeps plan changes calm and explainable."
    />
    <link rel="canonical" href={siteUrl} />
    <meta property="og:title" content="Runthread" />
    <meta
      property="og:description"
      content="Adaptive running plans, Strava-backed activity import, workout matching, and calm training changes."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta name="theme-color" content="#f6f2e8" />
  </head>
  <body>
    <header class="site-header" aria-label="Runthread">
      <a class="brand" href="/" aria-label="Runthread home">
        <span class="brand-mark" aria-hidden="true"></span>
        Runthread
      </a>
      <nav aria-label="Primary">
        <a href="#features">Features</a>
        <a href="#flow">How it works</a>
        <a href="#beta">Beta</a>
      </nav>
    </header>

    <main>
      <section class="hero section-band">
        <div class="hero-copy" data-reveal>
          <p class="eyebrow">Private beta</p>
          <h1>Running plans that adjust quietly.</h1>
          <p class="lede">
            Runthread connects your weekly plan to the runs you actually complete,
            then makes small, explainable changes when training does not go exactly
            to plan.
          </p>

          <form
            class="signup-form"
            data-waitlist-form
            action={signupAction}
            method="post"
            aria-describedby="signup-status signup-note"
          >
            <label class="sr-only" for="hero-email">Email address</label>
            <input
              id="hero-email"
              type="email"
              name="email"
              autocomplete="email"
              inputmode="email"
              placeholder="you@example.com"
              required
            />
            <input type="hidden" name="source" value="runthread.app landing_page" />
            <input type="hidden" name="userGroup" value="Beta waitlist" />
            <input type="hidden" name="notes" value="Runthread beta waitlist signup" />
            <button type="submit">Join beta waitlist</button>
            <p class="form-status" id="signup-status" data-form-status role="status"></p>
          </form>
          <p class="form-note" id="signup-note">
            Enter your email to join the private beta waitlist. Early access will
            be invite-only while Strava import, workout matching, and adaptation
            are validated.
          </p>
        </div>

        <div class="preview" data-reveal data-preview>
          <div class="preview-card">
            <div class="preview-top">
              <span data-preview-label>{previewCards[0].label}</span>
              <strong data-preview-status>{previewCards[0].status}</strong>
            </div>
            <h2 data-preview-title>{previewCards[0].title}</h2>
            <p data-preview-detail>{previewCards[0].detail}</p>
            <div class="preview-note">
              <span>Runthread</span>
              <p data-preview-note>{previewCards[0].note}</p>
            </div>
          </div>
          <div class="preview-controls" aria-label="Preview Runthread states">
            {
              previewCards.map((card, index) => (
                <button
                  class={index === 0 ? "is-active" : ""}
                  type="button"
                  data-preview-step={String(index)}
                  aria-pressed={index === 0 ? "true" : "false"}
                >
                  {card.status}
                </button>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section-band feature-band" id="features">
        <div class="section-heading" data-reveal>
          <p class="eyebrow">What it does</p>
          <h2>A simpler loop for adaptive training.</h2>
        </div>
        <div class="feature-grid">
          {
            features.map((feature) => (
              <article class="feature-card" data-reveal>
                <p>{feature.label}</p>
                <h3>{feature.title}</h3>
                <span>{feature.body}</span>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section-band flow-band" id="flow">
        <div class="section-heading compact" data-reveal>
          <p class="eyebrow">Beta focus</p>
          <h2>Not a louder running app.</h2>
        </div>
        <div class="statement-grid">
          <p data-reveal>
            The beta is intentionally narrow: weekly plan viewing, Strava-backed
            activity import, workout matching, and deterministic adaptation.
          </p>
          <p data-reveal>
            No streak pressure, no maximalist dashboard, and no mysterious training
            decisions. Just the next useful adjustment.
          </p>
        </div>
      </section>

      <section class="section-band beta-band" id="beta">
        <div class="beta-panel" data-reveal>
          <div>
            <p class="eyebrow">Beta access</p>
            <h2>One beta waitlist, two places to join.</h2>
            <p>
              This form submits to the same private beta waitlist as the signup
              above, for the first Runthread builds.
            </p>
          </div>
          <form
            class="signup-form compact-form"
            data-waitlist-form
            action={signupAction}
            method="post"
            aria-describedby="footer-signup-status"
          >
            <label class="sr-only" for="footer-email">Email address</label>
            <input
              id="footer-email"
              type="email"
              name="email"
              autocomplete="email"
              inputmode="email"
              placeholder="you@example.com"
              required
            />
            <input type="hidden" name="source" value="runthread.app landing_page" />
            <input type="hidden" name="userGroup" value="Beta waitlist" />
            <input type="hidden" name="notes" value="Runthread beta waitlist signup" />
            <button type="submit">Join beta waitlist</button>
            <p
              class="form-status"
              id="footer-signup-status"
              data-form-status
              role="status"
            >
            </p>
          </form>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <span>Runthread</span>
      <span>Adaptive running training for private beta.</span>
    </footer>

    <script src="../scripts/landing.ts"></script>
  </body>
</html>
