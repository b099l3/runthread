---
import FaqAccordion from "../components/FaqAccordion.astro";
import FeatureModule from "../components/FeatureModule.astro";
import ProductMockup from "../components/ProductMockup.astro";
import WaitlistForm from "../components/WaitlistForm.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const features = [
  {
    eyebrow: "Adaptive plans",
    title: "A training week with room for real life.",
    body: "Runthread starts from the sessions that matter, then keeps the rest of the week realistic when work, weather, or fatigue changes the plan.",
    variant: "plan",
  },
  {
    eyebrow: "Strava import",
    title: "Completed runs flow back into the plan.",
    body: "The beta is built around Strava-backed activity import so training decisions can respond to what actually happened.",
    variant: "import",
  },
  {
    eyebrow: "Workout matching",
    title: "A run gets linked to the workout it probably was.",
    body: "Date, distance, duration, and activity type help connect a completed run to the intended session with visible confidence.",
    variant: "match",
  },
  {
    eyebrow: "Calm adaptation",
    title: "Plan changes are small and explained.",
    body: "Runthread avoids dramatic resets. It shows what changed, why it changed, and what to do next.",
    variant: "adapt",
  },
  {
    eyebrow: "Beta privacy",
    title: "Only the data needed to test the loop.",
    body: "The first beta stays narrow: email signup, Strava-backed activity details, workout matching, and plan adaptation feedback.",
    variant: "privacy",
  },
] as const;

const flowSteps = [
  {
    number: "01",
    title: "Set the week",
    body: "Start with a plan that has structure without pretending every day is perfectly predictable.",
    meta: "Goal, days, key sessions",
  },
  {
    number: "02",
    title: "Run normally",
    body: "Complete your training where you already track it. The app is not another place to manually duplicate every detail.",
    meta: "Strava-backed import",
  },
  {
    number: "03",
    title: "Match the activity",
    body: "Runthread compares the completed activity with the planned session and shows the confidence behind the match.",
    meta: "Date, distance, duration",
  },
  {
    number: "04",
    title: "Adapt the next session",
    body: "When the week changes, the next useful adjustment is made without turning the plan into noise.",
    meta: "Explainable changes",
  },
];
---

<SiteLayout>
  <section class="hero shell">
    <div class="hero-copy" data-reveal>
      <p class="eyebrow">Private beta</p>
      <h1>Adaptive running plans, explained.</h1>
      <p class="lede">
        Runthread connects planned workouts to the runs you actually complete,
        then adjusts the week with calm, explainable changes.
      </p>
      <div id="waitlist" class="hero-form">
        <WaitlistForm id="hero-waitlist" />
        <p>
          Early access is invite-only while the plan, import, match, and adapt
          loop is tested with real runners.
        </p>
      </div>
    </div>
    <div class="hero-product" data-reveal>
      <ProductMockup />
    </div>
  </section>

  <section class="logo-strip shell" aria-label="Beta focus" data-reveal>
    <span>Adaptive plans</span>
    <span>Strava-backed import</span>
    <span>Workout matching</span>
    <span>Calm plan changes</span>
  </section>

  <section class="story-section shell" id="how-it-works">
    <div class="section-intro" data-reveal>
      <p class="eyebrow">How it works</p>
      <h2>A clearer loop for training weeks that change.</h2>
    </div>
    <div class="flow-grid">
      {
        flowSteps.map((step) => (
          <article class="flow-card" data-reveal>
            <span>{step.number}</span>
            <div class="flow-visual" aria-hidden="true">
              <i></i>
              <i></i>
              <i></i>
            </div>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
            <strong>{step.meta}</strong>
          </article>
        ))
      }
    </div>
  </section>

  <section class="feature-section shell" id="features">
    <div class="section-intro section-intro--split" data-reveal>
      <div>
        <p class="eyebrow">Feature showcase</p>
        <h2>Built around the moments where training plans usually break.</h2>
      </div>
      <p>
        The first version is intentionally focused. The goal is to make the
        adaptive loop useful before adding more dashboards, badges, or noise.
      </p>
    </div>
    <div class="feature-modules">
      {features.map((feature) => <FeatureModule {...feature} />)}
    </div>
  </section>

  <section class="product-details shell">
    <div class="detail-panel detail-panel--wide" data-reveal>
      <div>
        <p class="eyebrow">Training timeline</p>
        <h2>The week is visible, not buried.</h2>
        <p>
          See what is planned, what has been completed, and what changed after an
          imported activity. The beta keeps the core training story on one screen.
        </p>
      </div>
      <div class="timeline-preview" aria-hidden="true">
        <span class="done">Tue intervals matched</span>
        <span class="done">Wed easy imported</span>
        <span>Fri tempo ready</span>
        <span class="changed">Sun long run reduced</span>
      </div>
    </div>

    <div class="detail-panel" data-reveal>
      <p class="eyebrow">Import panel</p>
      <h3>Morning run</h3>
      <dl>
        <div><dt>Distance</dt><dd>6.8 km</dd></div>
        <div><dt>Duration</dt><dd>42 min</dd></div>
        <div><dt>Source</dt><dd>Strava</dd></div>
      </dl>
    </div>

    <div class="detail-panel" data-reveal>
      <p class="eyebrow">Match confidence</p>
      <h3>High confidence</h3>
      <div class="confidence-ring" aria-hidden="true">92%</div>
      <p>Matched to Wednesday easy run by date, duration, and effort range.</p>
    </div>

    <div class="detail-panel detail-panel--note" data-reveal>
      <p class="eyebrow">Adaptation note</p>
      <h3>Long run adjusted</h3>
      <p>
        Reduced Sunday by 1.5 km after a partial completion earlier in the week.
        Friday remains unchanged.
      </p>
    </div>
  </section>

  <section class="trust-section shell">
    <div class="founder-note" data-reveal>
      <p class="eyebrow">Founder note</p>
      <h2>Runthread is being built for runners who want less mystery.</h2>
      <p>
        The beta is about earning trust in a small loop: build a useful week,
        import completed runs, match them correctly, and explain any change. If
        that loop is not right, the rest of the product does not matter yet.
      </p>
    </div>
    <div class="trust-card" data-reveal>
      <span>Beta posture</span>
      <strong>Focused, not maximalist.</strong>
      <p>
        Email capture uses Loops. Activity import is scoped to the training data
        needed to validate matching and adaptation before wider beta access.
      </p>
      <a href="/privacy">Read the privacy placeholder</a>
    </div>
  </section>

  <section class="faq-section shell">
    <div class="section-intro" data-reveal>
      <p class="eyebrow">FAQ</p>
      <h2>Useful answers before the beta opens.</h2>
    </div>
    <FaqAccordion />
  </section>

  <section class="final-cta shell">
    <div data-reveal>
      <p class="eyebrow">Beta access</p>
      <h2>Join the first Runthread beta list.</h2>
      <p>
        The first invites will go to runners who are happy to test adaptive plan
        changes and give direct feedback.
      </p>
    </div>
    <div class="final-cta__form" data-reveal>
      <WaitlistForm id="final-waitlist" compact buttonLabel="Request access" />
      <a href="/beta">See beta details</a>
    </div>
  </section>
</SiteLayout>
