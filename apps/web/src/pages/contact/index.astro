---
import PlaceholderPage from "../../components/PlaceholderPage.astro";
---

<PlaceholderPage
  title="Contact | Runthread"
  description="Contact placeholder for Runthread beta and support enquiries."
  path="/contact"
  eyebrow="Contact"
  heading="A simple contact route for beta enquiries."
  lede="A direct contact method will be added before wider beta access. For now, the waitlist is the best way to register interest."
  showForm
  sections={[
    {
      title: "Beta enquiries",
      body: "The first version of this page will route questions about beta access, testing fit, and feedback.",
    },
    {
      title: "Support",
      body: "Support details will be added once invited testers have app access.",
    },
  ]}
/>
