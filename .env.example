# Local backend server bind address.
RUNTHREAD_SERVER_ADDR=:8080

# Optional local Postgres connection. Leave empty to use the in-memory store.
DATABASE_URL=postgres://runthread:runthread@localhost:5432/runthread?sslmode=disable

# Strava integration settings. Fill these in only for local provider testing.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_OAUTH_REDIRECT_URI=runthread://provider/strava/callback
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_API_BASE_URL=https://www.strava.com

# Secret key used to encrypt stored provider tokens in local development.
PROVIDER_TOKEN_ENCRYPTION_KEY=
